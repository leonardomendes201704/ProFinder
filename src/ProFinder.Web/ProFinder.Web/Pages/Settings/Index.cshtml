@page
@model ProFinder.Web.Pages.Settings.IndexModel
@{
    ViewData["Title"] = "Configuracoes";
}

<div class="page-header">
    <div>
        <h1>Configuracoes</h1>
        <p>Todos os parametros funcionais do crawler ficam persistidos no banco e podem ser ajustados aqui.</p>
    </div>
</div>

@foreach (var group in Model.Groups)
{
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <strong>@group.Category</strong>
            <span class="text-muted small">@group.Items.Count item(ns)</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Chave</th>
                        <th>Nome</th>
                        <th>Valor</th>
                        <th>Padrao</th>
                        <th>Tipo</th>
                        <th class="text-end">Acoes</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in group.Items)
                {
                    <tr>
                        <td><code>@item.Key</code></td>
                        <td>
                            <div class="fw-semibold">@item.DisplayName</div>
                            @if (!string.IsNullOrWhiteSpace(item.Description))
                            {
                                <div class="text-muted small">@item.Description</div>
                            }
                        </td>
                        <td><code>@IndexModel.FormatValue(item)</code></td>
                        <td><code>@item.DefaultValue</code></td>
                        <td>@item.DataType</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-primary" asp-page="/Settings/Edit" asp-route-id="@item.Id">Editar</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
