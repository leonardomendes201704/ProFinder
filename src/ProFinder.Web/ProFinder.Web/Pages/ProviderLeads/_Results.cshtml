@model ProFinder.Web.Pages.ProviderLeads.IndexModel

<div class="card">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h2 class="h5 mb-0">Resultados</h2>
        <div class="d-flex align-items-center gap-2">
            @if (Model.Result.TotalCount > 0)
            {
                <a class="btn btn-sm btn-outline-success"
                   asp-page="/ProviderLeads/Index"
                   asp-page-handler="Export"
                   asp-route-SearchTerm="@Model.SearchTerm"
                   asp-route-LeadSourceId="@Model.LeadSourceId"
                   asp-route-ProfessionId="@Model.ProfessionId"
                   asp-route-RegionId="@Model.RegionId"
                   asp-route-LeadCaptureRunId="@Model.LeadCaptureRunId"
                   asp-route-SiteKey="@Model.SiteKey"
                   asp-route-City="@Model.City"
                   asp-route-ImportStatus="@Model.ImportStatus">
                    Exportar Excel
                </a>
            }
            else
            {
                <button type="button" class="btn btn-sm btn-outline-success" disabled>Exportar Excel</button>
            }
            <button type="button"
                    class="btn btn-sm btn-outline-primary"
                    data-provider-leads-map-trigger
                    disabled="@(Model.Result.TotalCount == 0 ? "disabled" : null)">
                Ver no mapa
            </button>
            <span class="text-muted small">@Model.Result.TotalCount lead(s)</span>
        </div>
    </div>
    <div class="card-body p-0">
        @if (Model.Result.Items.Count == 0)
        {
            <div class="list-empty">Nenhum lead encontrado.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Nome</th>
                            <th>Contato</th>
                            <th>Localidade</th>
                            <th>Origem</th>
                            <th>Profissoes</th>
                            <th>Status</th>
                            <th>Captado em</th>
                            <th class="text-end">Acoes</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model.Result.Items)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold">@item.Name</div>
                                <div class="small text-muted">Lote #@item.LeadCaptureRunId</div>
                            </td>
                            <td>
                                <div>@(item.Phone ?? "-")</div>
                                <div class="small text-muted">WhatsApp: @(item.WhatsApp ?? "-")</div>
                            </td>
                            <td>
                                <div>@(string.IsNullOrWhiteSpace(item.LocalityDisplay) ? "-" : item.LocalityDisplay)</div>
                                <div class="small text-muted">Regiao-alvo: @(item.RegionDisplayName ?? "-")</div>
                            </td>
                            <td>
                                <div>@item.SourceName</div>
                                <div class="small text-muted">@item.SiteKey</div>
                            </td>
                            <td>@(string.IsNullOrWhiteSpace(item.ProfessionNamesDisplay) ? "-" : item.ProfessionNamesDisplay)</td>
                            <td>
                                <span class="badge bg-light text-dark border">@item.ImportStatus</span>
                                <div class="small text-muted">@item.SourceCount fonte(s)</div>
                            </td>
                            <td>@item.ScrapedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-2">
                                    <a class="btn btn-sm btn-outline-primary" asp-page="/ProviderLeads/Details" asp-route-id="@item.Id">Detalhes</a>
                                    @if (item.ImportedProfessionalId.HasValue)
                                    {
                                        <a class="btn btn-sm btn-outline-success" asp-page="/Professionals/Details" asp-route-id="@item.ImportedProfessionalId.Value">Ver profissional</a>
                                    }
                                    else
                                    {
                                        <a class="btn btn-sm btn-outline-success"
                                           href="@Url.Page("/Professionals/Create", new { leadId = item.Id, returnUrl = Model.CurrentListUrl })">Converter</a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
    @if (Model.Result.TotalPages > 1)
    {
        <div class="card-footer bg-white">
            <nav aria-label="Paginacao de leads capturados">
                <ul class="pagination mb-0">
                    <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : null)">
                        <a class="page-link"
                           asp-page="/ProviderLeads/Index"
                           asp-route-SearchTerm="@Model.SearchTerm"
                           asp-route-LeadSourceId="@Model.LeadSourceId"
                           asp-route-ProfessionId="@Model.ProfessionId"
                           asp-route-RegionId="@Model.RegionId"
                           asp-route-LeadCaptureRunId="@Model.LeadCaptureRunId"
                           asp-route-SiteKey="@Model.SiteKey"
                           asp-route-City="@Model.City"
                           asp-route-ImportStatus="@Model.ImportStatus"
                           asp-route-PageSize="@Model.PageSize"
                           asp-route-PageNumber="@(Model.PageNumber - 1)">Anterior</a>
                    </li>
                    @for (var pageIndex = 1; pageIndex <= Model.Result.TotalPages; pageIndex++)
                    {
                        <li class="page-item @(pageIndex == Model.PageNumber ? "active" : null)">
                            <a class="page-link"
                               asp-page="/ProviderLeads/Index"
                               asp-route-SearchTerm="@Model.SearchTerm"
                               asp-route-LeadSourceId="@Model.LeadSourceId"
                               asp-route-ProfessionId="@Model.ProfessionId"
                               asp-route-RegionId="@Model.RegionId"
                               asp-route-LeadCaptureRunId="@Model.LeadCaptureRunId"
                               asp-route-SiteKey="@Model.SiteKey"
                               asp-route-City="@Model.City"
                               asp-route-ImportStatus="@Model.ImportStatus"
                               asp-route-PageSize="@Model.PageSize"
                               asp-route-PageNumber="@pageIndex">@pageIndex</a>
                        </li>
                    }
                    <li class="page-item @(Model.PageNumber >= Model.Result.TotalPages ? "disabled" : null)">
                        <a class="page-link"
                           asp-page="/ProviderLeads/Index"
                           asp-route-SearchTerm="@Model.SearchTerm"
                           asp-route-LeadSourceId="@Model.LeadSourceId"
                           asp-route-ProfessionId="@Model.ProfessionId"
                           asp-route-RegionId="@Model.RegionId"
                           asp-route-LeadCaptureRunId="@Model.LeadCaptureRunId"
                           asp-route-SiteKey="@Model.SiteKey"
                           asp-route-City="@Model.City"
                           asp-route-ImportStatus="@Model.ImportStatus"
                           asp-route-PageSize="@Model.PageSize"
                           asp-route-PageNumber="@(Model.PageNumber + 1)">Proxima</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
