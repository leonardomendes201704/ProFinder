@model ProFinder.Web.Pages.Regions.RegionFormPageModel

<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

<div id="region-form"
     class="row g-3"
     data-region-lookup-url="@Url.Page("/Regions/Lookup")">
    <div class="col-md-4">
        <label asp-for="Input.State" class="form-label"></label>
        <select asp-for="Input.State" asp-items="Model.StateOptions" class="form-select">
            <option value="">Selecione um estado</option>
        </select>
        <span asp-validation-for="Input.State" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Input.City" class="form-label"></label>
        <select asp-for="Input.City" asp-items="Model.CityOptions" class="form-select" data-selected-value="@Model.Input.City">
            <option value="">Selecione uma cidade</option>
        </select>
        <span asp-validation-for="Input.City" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Input.Neighborhood" class="form-label"></label>
        <select asp-for="Input.Neighborhood" asp-items="Model.NeighborhoodOptions" class="form-select" data-selected-value="@Model.Input.Neighborhood">
            <option value="">Selecione um bairro</option>
        </select>
        <div class="form-text">Base oficial por distritos do IBGE; o CEP complementa o bairro quando houver retorno mais específico.</div>
        <span asp-validation-for="Input.Neighborhood" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Input.Zone" class="form-label"></label>
        <input asp-for="Input.Zone" class="form-control" />
        <span asp-validation-for="Input.Zone" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Input.ZipCode" class="form-label"></label>
        <input asp-for="Input.ZipCode" class="form-control" maxlength="9" placeholder="00000-000" />
        <div class="form-text">Ao informar o CEP, o sistema tenta preencher UF, cidade, bairro e coordenadas.</div>
        <span asp-validation-for="Input.ZipCode" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Input.RadiusKm" class="form-label"></label>
        <input asp-for="Input.RadiusKm" class="form-control" type="number" step="0.01" min="0" />
        <span asp-validation-for="Input.RadiusKm" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Input.Latitude" class="form-label"></label>
        <input asp-for="Input.Latitude" class="form-control" type="number" step="0.000001" />
        <div class="form-text">Preenchida automaticamente quando o CEP puder ser geocodificado.</div>
        <span asp-validation-for="Input.Latitude" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Input.Longitude" class="form-label"></label>
        <input asp-for="Input.Longitude" class="form-control" type="number" step="0.000001" />
        <span asp-validation-for="Input.Longitude" class="text-danger"></span>
    </div>
</div>

<div class="form-check my-4">
    <input asp-for="Input.IsActive" class="form-check-input" />
    <label asp-for="Input.IsActive" class="form-check-label"></label>
</div>
