<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ProFinder Admin</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ProFinder.Web.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="app-shell">
        <header class="app-header shadow-sm">
            <nav class="navbar navbar-expand-lg navbar-dark">
                <div class="container-fluid px-4">
                    <a class="navbar-brand fw-semibold" asp-page="/Index">ProFinder Admin</a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Alternar navegacao">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="mainNav">
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                            <li class="nav-item"><a class="nav-link" asp-page="/Index">Dashboard</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Professionals/Index">Profissionais</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/GoogleMapsLeads/Index">Google Maps</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/CrawlerRuns/Index">Crawler Lotes</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/ProviderLeads/Index">Crawler Leads</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Interactions/Index">Interacoes</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Professions/Index">Profissoes</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Regions/Index">Regioes</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Sources/Index">Origens</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Statuses/Index">Status</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Settings/Index">Configuracoes</a></li>
                        </ul>
                    </div>
                </div>
            </nav>
        </header>

        <main class="container-fluid px-4 py-4">
            @if (TempData["SuccessMessage"] is string successMessage)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @successMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] is string errorMessage)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @errorMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
                </div>
            }

            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
