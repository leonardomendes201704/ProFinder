@page
@model ProFinder.Web.Pages.Professionals.CreateModel
@{
    ViewData["Title"] = "Novo profissional";
}

<div class="page-header">
    <div>
        <h1>Novo profissional</h1>
        <p>Cadastre um profissional e vincule sua atuação por região.</p>
    </div>
    <a class="btn btn-outline-secondary" asp-page="/Professionals/Index">Voltar</a>
</div>

<div class="card">
    <div class="card-body">
        <form method="post">
            @await Html.PartialAsync("_ProfessionalForm", Model)
            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">Salvar</button>
                <a class="btn btn-outline-secondary" asp-page="/Professionals/Index">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
