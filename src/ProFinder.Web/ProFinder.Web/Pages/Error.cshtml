@page
@model ErrorModel
@{
    ViewData["Title"] = "Erro";
}

<div class="page-header">
    <div>
        <h1>Erro inesperado</h1>
        <p>Ocorreu um problema ao processar sua solicitação.</p>
    </div>
</div>

@if (Model.ShowRequestId)
{
    <div class="alert alert-secondary">
        <strong>ID da requisição:</strong> <code>@Model.RequestId</code>
    </div>
}

<div class="card">
    <div class="card-body">
        <p class="mb-0">Se o problema persistir, verifique os logs da aplicação e a disponibilidade do SQL Server configurado em <code>appsettings.json</code>.</p>
    </div>
</div>
