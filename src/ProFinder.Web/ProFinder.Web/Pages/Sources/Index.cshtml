@page
@model ProFinder.Web.Pages.Sources.IndexModel
@{
    ViewData["Title"] = "Origens";
}

<div class="page-header">
    <div>
        <h1>Origens do lead</h1>
        <p>Gerencie as fontes utilizadas para captar ou importar profissionais.</p>
    </div>
    <a class="btn btn-primary" asp-page="/Sources/Create">Nova origem</a>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Nome</th>
                        <th>Descrição</th>
                        <th>URL</th>
                        <th>Ativa</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.Name</td>
                            <td>@item.Description</td>
                            <td>@item.Url</td>
                            <td>@(item.IsActive ? "Sim" : "Não")</td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-2">
                                    <a class="btn btn-sm btn-outline-primary" asp-page="/Sources/Edit" asp-route-id="@item.Id">Editar</a>
                                    @if (item.IsActive)
                                    {
                                        <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id" onsubmit="return confirm('Deseja desativar esta origem?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Desativar</button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
